{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "PaymentCollectionResponse",
	"type": "object",
	"properties": {
		"payment_collection": {
			"$ref": "#/definitions/PaymentCollectionDetail"
		},
		"soft_reservation_status": {
			"type": "string"
		}
	},
	"required": [
		"payment_collection",
		"soft_reservation_status"
	],
	"additionalProperties": true,
	"definitions": {
		"PaymentCollectionDetail": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"currency_code": {
					"type": "string"
				},
				"amount": {
					"type": "number"
				},
				"payment_sessions": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/PaymentSession"
					}
				}
			},
			"required": [
				"id",
				"currency_code",
				"amount",
				"payment_sessions"
			],
			"additionalProperties": true
		},
		"PaymentSession": {
			"type": "object",
			"properties": {
