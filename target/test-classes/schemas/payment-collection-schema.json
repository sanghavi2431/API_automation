					"type": "string"
				},
				"currency_code": {
					"type": "string"
				},
				"provider_id": {
					"type": "string"
				},
				"data": {},
				"context": {
					"oneOf": [
						{
							"$ref": "#/definitions/PaymentSessionContext"
						},
						{
							"type": "null"
						}
					]
				},
				"status": {
					"type": "string"
				},
				"authorized_at": {
					"type": [
						"string",
						"null"
					]
				},
				"payment_collection_id": {
					"type": "string"
				},
				"metadata": {
					"type": [
						"object",
						"null"
					]
				},
				"raw_amount": {
					"$ref": "#/definitions/RawAmount"
				},
				"created_at": {
					"type": "string"
				},
				"updated_at": {
					"type": "string"
				},
				"deleted_at": {
					"type": [
						"string",
						"null"
					]
				},
				"amount": {
					"type": "number"
				}
			},
			"required": [
				"id",
				"currency_code",
				"provider_id",
				"status",
				"payment_collection_id",
				"raw_amount",
				"amount"
			],
			"additionalProperties": true
		},
		"PaymentSessionContext": {
			"type": "object",
			"properties": {
				"customer": {
					"$ref": "#/definitions/PaymentContextCustomer"
				}
			},
			"required": [
				"customer"
			],
			"additionalProperties": true
		},
		"PaymentContextCustomer": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"email": {
					"type": [
						"string",
						"null"
					]
				},
				"phone": {
					"type": [
						"string",
						"null"
					]
				},
				"metadata": {
					"type": [
						"object",
						"null"
					]
				},
				"addresses": {
					"type": "array"
				},
				"last_name": {
					"type": [
						"string",
						"null"
					]
				},
				"first_name": {
					"type": [
						"string",
						"null"
					]
				},
				"company_name": {
					"type": [
						"string",
						"null"
					]
				},
				"account_holders": {
					"type": "array"
				}
			},
			"required": [
				"id"
			],
			"additionalProperties": true
		},
		"RawAmount": {
			"type": "object",
			"properties": {
				"value": {
					"type": "string"
				},
				"precision": {
					"type": "integer"
				}
			},
			"required": [
				"value",
				"precision"
			],
			"additionalProperties": true
